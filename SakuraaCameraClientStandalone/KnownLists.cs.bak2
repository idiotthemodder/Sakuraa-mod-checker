using System;
using System.Collections.Generic;
using System.IO;
using System.Reflection;
using BepInEx;
using UnityEngine;

namespace SakuraaCameraClientStandalone;

public sealed partial class StandalonePlugin
{
	private static bool _knownListsLoaded;

	private static void StatusLog(string text)
	{
		try
		{
			File.AppendAllText(Path.Combine(Paths.ConfigPath, "sakuraa_status.txt"), DateTime.Now.ToString("HH:mm:ss") + " " + text + Environment.NewLine);
		}
		catch
		{
		}
	}

	private static void PatchKnownLists(Assembly core)
	{
		Type page = core.GetType("SakuraaCastingMod.VR.UtilMenu.Pages.LobbyPage", throwOnError: true);
		MethodInfo target = page.GetMethod("GetDetectedMods", BindingFlags.Static | BindingFlags.Public);
		if (target == null)
		{
			throw new MissingMethodException(page.FullName, "GetDetectedMods");
		}
		MethodInfo prefix = typeof(StandalonePlugin).GetMethod("KnownListsPrefix", BindingFlags.Static | BindingFlags.NonPublic);
		new HarmonyLib.Harmony("local.sakuraa.knownlists").Patch(target, prefix: new HarmonyLib.HarmonyMethod(prefix));
		StatusLog("known lists patch installed");
	}

	private static void KnownListsPrefix(MethodBase __originalMethod)
	{
		if (_knownListsLoaded)
		{
			return;
		}
		_knownListsLoaded = true;
		StatusLog("checker ran for the first time");
		try
		{
			Type page = __originalMethod.DeclaringType;
			FillList(page, "_webKnownMods", "sakuraa_known_mods.txt");
			FillList(page, "_webKnownCheats", "sakuraa_known_cheats.txt");
		}
		catch (Exception ex)
		{
			StatusLog("known lists failed: " + ex.Message);
			Debug.LogError((object)("[KnownLists] " + ex.Message));
		}
	}

	private static void FillList(Type page, string fieldName, string fileName)
	{
		string path = Path.Combine(Paths.ConfigPath, fileName);
		if (!File.Exists(path))
		{
			StatusLog(fileName + " not found");
			return;
		}
		FieldInfo field = page.GetField(fieldName, BindingFlags.Static | BindingFlags.NonPublic);
		Dictionary<string, string> dict = (field != null) ? (field.GetValue(null) as Dictionary<string, string>) : null;
		if (dict == null)
		{
			StatusLog("could not find " + fieldName);
			return;
		}
		int count = 0;
		foreach (string raw in File.ReadAllLines(path))
		{
			string line = raw.Trim();
			if (line.Length == 0 || line.StartsWith("#"))
			{
				continue;
			}
			int eq = line.IndexOf('=');
			if (eq <= 0)
			{
				continue;
			}
			string key = line.Substring(0, eq).Trim();
			string label = line.Substring(eq + 1).Trim();
			if (key.Length > 0 && label.Length > 0)
			{
				dict[key] = label;
				count++;
			}
		}
		StatusLog("loaded " + count + " entries from " + fileName);
		Debug.Log((object)("[KnownLists] loaded " + count + " entries from " + fileName));
	}
}
