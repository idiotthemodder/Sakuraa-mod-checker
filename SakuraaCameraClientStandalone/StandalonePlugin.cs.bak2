using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.IO.Compression;
using System.Linq;
using System.Reflection;
using System.Runtime.CompilerServices;
using BepInEx;
using UnityEngine;
using Object = UnityEngine.Object;

namespace SakuraaCameraClientStandalone;

[BepInPlugin("com.dusted.sakuraa.standalone", "Sakuraa Camera Client - Recovered Standalone Build", "2.0.0")]
public sealed class StandalonePlugin : BaseUnityPlugin
{
	private static readonly Dictionary<string, string> ResourceNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
	{
		{ "SakuraaCastingMod", "CleanPayload.SakuraaCastingMod.dll.br" },
		{ "SakMerge", "CleanPayload.SakMerge.dll.br" },
		{ "GorillaRigUtil", "CleanPayload.GorillaRigUtil.dll.br" },
		{ "SpotifyAPI.Web", "CleanPayload.SpotifyAPI.Web.dll.br" },
		{ "SpotifyAPI.Web.Auth", "CleanPayload.SpotifyAPI.Web.Auth.dll.br" },
		{ "EmbedIO", "CleanPayload.EmbedIO.dll.br" },
		{ "Swan.Lite", "CleanPayload.Swan.Lite.dll.br" },
		{ "SakuraaOfflinePresets", "CleanPayload.SakuraaOfflinePresets.dll.br" }
	};

	private static readonly Dictionary<string, Assembly> LoadedAssemblies = new Dictionary<string, Assembly>(StringComparer.OrdinalIgnoreCase);

	private static bool _resolverInstalled;

	private static bool _started;

	private void Awake()
	{
		Object.DontDestroyOnLoad((Object)(object)((Component)this).gameObject);
		InstallResolver();
		((MonoBehaviour)this).StartCoroutine(StartRecoveredClient());
	}

	private IEnumerator StartRecoveredClient()
	{
		if (_started)
		{
			yield break;
		}
		_started = true;
		yield return null;
		if (FindLoadedAssembly("SakuraaCastingMod") != null)
		{
			Logger.LogError((object)"SakuraaCastingMod is already loaded. The clean standalone build will not start beside a launcher-injected copy.");
			yield break;
		}
		try
		{
			Assembly? assembly = FindLoadedAssembly("GorillaRigUtil");
			Assembly assembly2 = assembly ?? LoadEmbeddedAssembly("GorillaRigUtil");
			if (assembly == null)
			{
				AttachUnityComponent(assembly2, "GorillaRigUtil.Plugin", "Embedded GorillaRigUtil");
			}
			Assembly? assembly3 = FindLoadedAssembly("SakMerge");
			Assembly assembly4 = assembly3 ?? LoadEmbeddedAssembly("SakMerge");
			if (assembly3 == null)
			{
				InvokeLoader(assembly4, "SakMerge");
			}
			Assembly assembly5 = LoadEmbeddedAssembly("SakuraaCastingMod");
			ConfigureStandaloneFeatures(assembly5);
			InvokeLoader(assembly5, "Sakuraa camera client");
			Logger.LogInfo((object)"Recovered Sakuraa camera client started without the native launcher.");
		}
		catch (TargetInvocationException ex)
		{
			_started = false;
			Exception? obj = ex.InnerException ?? ex;
			Logger.LogError((object)("Recovered Sakuraa client failed to start: " + obj));
		}
		catch (Exception ex2)
		{
			_started = false;
			Logger.LogError((object)("Recovered Sakuraa client failed to start: " + ex2));
		}
	}

	private static void ConfigureStandaloneFeatures(Assembly core)
	{
		Type? type = core.GetType("SakuraaCastingMod.Core.FeatureToggles", throwOnError: true);
		RuntimeHelpers.RunClassConstructor(type.TypeHandle);
		SetStaticField(type, "<ShowTablet>k__BackingField", true);
		SetStaticField(type, "<ShowDesktopCasting>k__BackingField", true);
		SetStaticField(type, "<ShowCameraTablet>k__BackingField", true);
		SetStaticField(type, "<ShowReplaySystem>k__BackingField", true);
		SetStaticField(type, "<DiscordRpc>k__BackingField", false);
	}

	private static void InvokeLoader(Assembly assembly, string label)
	{
		MethodInfo? method = assembly.GetType("Loader.ErmWhatTheSigma", throwOnError: true).GetMethod("Load", BindingFlags.Static | BindingFlags.Public);
		if (method == null)
		{
			throw new MissingMethodException(label + " entrypoint Loader.ErmWhatTheSigma.Load was not found.");
		}
		method.Invoke(null, null);
	}

	private static void SetStaticField(Type owner, string fieldName, object value)
	{
		FieldInfo? field = owner.GetField(fieldName, BindingFlags.Static | BindingFlags.NonPublic);
		if (field == null)
		{
			throw new MissingFieldException(owner.FullName, fieldName);
		}
		field.SetValue(null, value);
	}

	private static void AttachUnityComponent(Assembly assembly, string typeName, string objectName)
	{
		//IL_000a: Unknown result type (might be due to invalid IL or missing references)
		//IL_000f: Unknown result type (might be due to invalid IL or missing references)
		//IL_0015: Expected O, but got Unknown
		Type type = assembly.GetType(typeName, throwOnError: true);
		GameObject val = new GameObject(objectName);
		Object.DontDestroyOnLoad((Object)val);
		val.AddComponent(type);
	}

	private static void InstallResolver()
	{
		if (!_resolverInstalled)
		{
			AppDomain.CurrentDomain.AssemblyResolve += ResolveEmbeddedAssembly;
			_resolverInstalled = true;
		}
	}

	private static Assembly? ResolveEmbeddedAssembly(object sender, ResolveEventArgs args)
	{
		string name = new AssemblyName(args.Name).Name;
		if (string.IsNullOrEmpty(name))
		{
			return null;
		}
		Assembly assembly = FindLoadedAssembly(name);
		if (assembly != null)
		{
			return assembly;
		}
		if (!ResourceNames.ContainsKey(name))
		{
			return null;
		}
		return LoadEmbeddedAssembly(name);
	}

	private static Assembly LoadEmbeddedAssembly(string simpleName)
	{
		Assembly assembly = FindLoadedAssembly(simpleName);
		if (assembly != null)
		{
			return assembly;
		}
		if (LoadedAssemblies.TryGetValue(simpleName, out Assembly value))
		{
			return value;
		}
		if (!ResourceNames.TryGetValue(simpleName, out string value2))
		{
			throw new FileNotFoundException("No embedded assembly is registered for " + simpleName + ".");
		}
		Assembly assembly2 = Assembly.Load(ReadCompressedResource(value2));
		LoadedAssemblies[simpleName] = assembly2;
		return assembly2;
	}

	private static Assembly? FindLoadedAssembly(string simpleName)
	{
		return AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault((Assembly assembly) => string.Equals(assembly.GetName().Name, simpleName, StringComparison.OrdinalIgnoreCase));
	}

	private static byte[] ReadCompressedResource(string resourceName)
	{
		using Stream stream = typeof(StandalonePlugin).Assembly.GetManifestResourceStream(resourceName);
		if (stream == null)
		{
			throw new InvalidOperationException("Embedded resource is missing: " + resourceName);
		}
		using BrotliStream brotliStream = new BrotliStream(stream, CompressionMode.Decompress);
		using MemoryStream memoryStream = new MemoryStream();
		brotliStream.CopyTo(memoryStream);
		return memoryStream.ToArray();
	}

	public static void ApplyHarmonyPatches()
	{
		Assembly executingAssembly = Assembly.GetExecutingAssembly();
		Stream manifestResourceStream = executingAssembly.GetManifestResourceStream("Harmony.PatchInfo.bin");
		MemoryStream memoryStream = new MemoryStream();
		manifestResourceStream.CopyTo(memoryStream);
		byte[] rawAssembly = memoryStream.ToArray();
		Assembly assembly = Assembly.Load(rawAssembly);
		Type type = assembly.GetType("HarmonyX.Internal.PatchProcessor");
		MethodInfo method = type.GetMethod("Initialize");
		method.Invoke((object)null, (object[])null);
	}

	public void Start()
	{
		ApplyHarmonyPatches();
	}
}
